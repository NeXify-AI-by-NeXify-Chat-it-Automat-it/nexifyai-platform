# NeXifyAI — Environment Variables Template
# Kopiere nach backend/.env und fülle aus.
# KEINE Secrets in Git! Nur diese .env.example ist versioniert.

# ═══════════════════════════════════════
# LLM PROVIDER
# ═══════════════════════════════════════
OPENROUTER_API_KEY=sk-or-...
# Quelle: https://openrouter.ai/keys
# Scope: API-Zugriff für Chat Completions
# Ablauf: Prüfen unter https://openrouter.ai/settings/keys

# ═══════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════
MONGO_URL=mongodb://localhost:27017
DB_NAME=nexifyai
SUPABASE_URL=http://localhost:5432
SUPABASE_SERVICE_ROLE_KEY=...
POSTGRES_PASSWORD=postgres

# ═══════════════════════════════════════
# EMAIL
# ═══════════════════════════════════════
RESEND_API_KEY=re_...
ADMIN_EMAIL=p.courbois@icloud.com

# ═══════════════════════════════════════
# AUTH
# ═══════════════════════════════════════
JWT_SECRET=...               # Mind. 32 Zeichen
ADMIN_PASSWORD=...           # Backend-Admin-Passwort

# ═══════════════════════════════════════
# EXTERNAL APIs
# ═══════════════════════════════════════
ARCEE_API_KEY=...
JINA_API_KEY=...
SERPAPI_KEY=...
REVOLUT_SECRET_KEY=...

# ═══════════════════════════════════════
# DEPLOYMENT
# ═══════════════════════════════════════
VERCEL_TOKEN=...             # https://vercel.com/account/tokens
GITHUB_TOKEN=...             # https://github.com/settings/tokens
GITHUB_REPO=nexifyai-dev/nexifyai-website-sicherheitskopie
CRON_SECRET=...
GATEWAY_API_KEY=...

# ═══════════════════════════════════════
# FRONTEND (REACT)
# ═══════════════════════════════════════
REACT_APP_API_URL=https://nexifyai.nexifyai.cloud
