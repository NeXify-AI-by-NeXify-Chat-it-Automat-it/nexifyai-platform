#!/bin/bash
# NeXifyAI Pre-Push Hook — Prinzip F
# Fuehrt npm run build vor jedem Push aus.
# Blockiert Push bei Build-Fehler.
# Install: ln -s ../../.githooks/pre-push .git/hooks/

set -e

echo "═══════════════════════════════════════"
echo " Pre-Push Hook: npm run build (Prinzip F)"
echo "═══════════════════════════════════════"

REPO_ROOT=$(git rev-parse --show-toplevel)

# Nur ausführen wenn apps/web/ im aktuellen Commit geändert wurde
APPS_WEB_CHANGED=$(git diff-tree --no-commit-id -r HEAD --name-only 2>/dev/null | grep "^apps/web/" || true)

if [ -z "$APPS_WEB_CHANGED" ]; then
    echo "✓ Keine Frontend-Änderungen in apps/web/ — Build übersprungen."
    exit 0
fi

echo "→ Frontend-Änderungen erkannt:"
echo "$APPS_WEB_CHANGED" | head -5
echo "→ Starte Build..."

cd "$REPO_ROOT/apps/web"

if npm run build 2>&1 | tail -5; then
    BUILD_EXIT=$?
    if [ $BUILD_EXIT -eq 0 ]; then
        echo ""
        echo "✓ Build erfolgreich — Push erlaubt."
        exit 0
    fi
fi

echo ""
echo "❌ BUILD FEHLGESCHLAGEN — Push blockiert."
echo "   Fehler beheben und erneut versuchen."
exit 1
