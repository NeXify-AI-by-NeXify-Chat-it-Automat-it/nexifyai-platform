{
  "title": "Customer Overview",
  "uid": "nexifyai-customer-overview",
  "version": 2,
  "tags": ["nexifyai", "customer", "business"],
  "schemaVersion": 39,
  "timezone": "utc",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "60s",
  "panels": [
    {
      "id": 1,
      "title": "Total HTTP Requests (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(increase(http_requests_total[24h]))", "legendFormat": "Total" }],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "title": "Error Rate (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "sum(increase(http_requests_total{status=~\"5..\"}[24h])) / sum(increase(http_requests_total[24h])) * 100", "legendFormat": "Error %" }],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 10 }] } } }
    },
    {
      "id": 3,
      "title": "Active Admin API Sessions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "nexify_admin_api_up", "legendFormat": "API Up" }],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } }
    },
    {
      "id": 4,
      "title": "Request Rate (24h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "rate(http_requests_total[5m])", "legendFormat": "Requests/s" }],
      "fieldConfig": { "defaults": { "unit": "rps" } },
      "options": { "legend": { "calcs": ["min", "max", "avg"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "title": "Admin API Requests",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "rate(nexify_admin_api_requests_total[5m])", "legendFormat": "Admin API req/s" }],
      "fieldConfig": { "defaults": { "unit": "rps" } },
      "options": { "legend": { "calcs": ["min", "max", "avg"], "displayMode": "table", "placement": "bottom" } }
    },
    {
      "id": 6,
      "title": "Rate Limits by Endpoint",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "sum by(endpoint) (rate(nexify_rate_limit_hits_total[1h]))", "legendFormat": "{{endpoint}}" }],
      "fieldConfig": { "defaults": { "unit": "rps" } },
      "options": { "orientation": "auto", "xTickLabelRotation": 0, "showValues": true }
    },
    {
      "id": 7,
      "title": "Rate Limit Blocked by Endpoint",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "expr": "sum by(endpoint) (rate(nexify_rate_limit_blocked_total[1h]))", "legendFormat": "{{endpoint}}" }],
      "fieldConfig": { "defaults": { "unit": "rps" } },
      "options": { "orientation": "auto", "xTickLabelRotation": 0, "showValues": true }
    }
  ]
}
