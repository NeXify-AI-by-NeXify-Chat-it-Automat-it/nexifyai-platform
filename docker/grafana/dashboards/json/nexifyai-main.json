{
  "title": "NeXifyAI",
  "uid": "ee950a10-c887-4bc5-80e0-16c763a6452f",
  "version": 1,
  "tags": ["nexifyai", "main", "overview", "oracle-v10"],
  "schemaVersion": 39,
  "timezone": "utc",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Brain API Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 3, "x": 0, "y": 0},
      "targets": [{"expr": "up{job=\"nexifyai-oracle-engine\"}", "legendFormat": "Brain"}],
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "textMode": "auto"},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 2,
      "title": "Qdrant Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 3, "x": 3, "y": 0},
      "targets": [{"expr": "up{job=\"nexifyai-oracle-engine\"}", "legendFormat": "Qdrant"}],
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "textMode": "auto"},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 3,
      "title": "9Router Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 3, "x": 6, "y": 0},
      "targets": [{"expr": "up{job=\"nexifyai-oracle-engine\"}", "legendFormat": "9Router"}],
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "textMode": "auto"},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 4,
      "title": "Services Up",
      "type": "stat",
      "gridPos": {"h": 4, "w": 3, "x": 9, "y": 0},
      "targets": [{"expr": "count(up == 1)", "legendFormat": "Up"}],
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "textMode": "auto"},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "red", "value": null}, {"color": "orange", "value": 2}, {"color": "green", "value": 4}]}}}
    },
    {
      "id": 5,
      "title": "Services Down",
      "type": "stat",
      "gridPos": {"h": 4, "w": 3, "x": 12, "y": 0},
      "targets": [{"expr": "count(up == 0)", "legendFormat": "Down"}],
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "textMode": "auto"},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 2}]}}}
    },
    {
      "id": 6,
      "title": "System Uptime",
      "type": "stat",
      "gridPos": {"h": 4, "w": 3, "x": 15, "y": 0},
      "targets": [{"expr": "node_time_seconds - node_boot_time_seconds", "legendFormat": "Uptime"}],
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "textMode": "auto"},
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0}}
    },
    {
      "id": 7,
      "title": "CPU Usage",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 4, "x": 0, "y": 4},
      "targets": [{"expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)", "legendFormat": "CPU"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "showThresholdLabels": false, "showThresholdMarkers": true},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}}}
    },
    {
      "id": 8,
      "title": "Memory Usage",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 4, "x": 4, "y": 4},
      "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "RAM"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "showThresholdLabels": false, "showThresholdMarkers": true},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}]}}}
    },
    {
      "id": 9,
      "title": "Disk Usage",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 4, "x": 8, "y": 4},
      "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"})", "legendFormat": "Disk"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "showThresholdLabels": false, "showThresholdMarkers": true},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 95}]}}}
    },
    {
      "id": 10,
      "title": "CPU Load (5m)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 4},
      "targets": [{"expr": "node_load5", "legendFormat": "Load 5m"}, {"expr": "count(node_cpu_seconds_total{mode=\"user\"}) / 2", "legendFormat": "CPU Count"}],
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"}},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 6}, {"color": "red", "value": 10}]}}}
    },
    {
      "id": 11,
      "title": "Qdrant Points Over Time",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 10},
      "targets": [{"expr": "nexifyai_brain_stats{stat=\"points\"}", "legendFormat": "Qdrant Points"}],
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"}},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 100000}, {"color": "red", "value": 250000}]}}}
    },
    {
      "id": 12,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 10},
      "targets": [{"expr": "rate(prometheus_http_requests_total[5m])", "legendFormat": "{{handler}}"}],
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 13,
      "title": "Memory Over Time",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 10},
      "targets": [{"expr": "node_memory_MemTotal_bytes", "legendFormat": "Total"}, {"expr": "node_memory_MemAvailable_bytes", "legendFormat": "Available"}, {"expr": "node_memory_MemFree_bytes", "legendFormat": "Free"}],
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"}},
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 14,
      "title": "Disk IO",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 16},
      "targets": [{"expr": "rate(node_disk_io_time_seconds_total[5m])", "legendFormat": "{{device}}"}],
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 15,
      "title": "Network IO",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 16},
      "targets": [{"expr": "rate(node_network_receive_bytes_total[5m])", "legendFormat": "RX {{device}}"}, {"expr": "rate(node_network_transmit_bytes_total[5m])", "legendFormat": "TX {{device}}"}],
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"}},
      "fieldConfig": {"defaults": {"unit": "bps"}}
    },
    {
      "id": 16,
      "title": "Container Status",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 16},
      "targets": [{"expr": "count(container_last_seen > 0)", "legendFormat": "Running"}],
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"}}
    }
  ]
}
